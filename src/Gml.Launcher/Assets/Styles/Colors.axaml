    <!-- Scrims over the night scene: under a text column on the left, and the fade at the bottom -->
    <LinearGradientBrush x:Key="HfScrimLeftBrush" StartPoint="0%, 0%" EndPoint="100%, 0%">
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0" Color="#EB100A22" />
            <GradientStop Offset="0.42" Color="#CC100A22" />
            <GradientStop Offset="0.58" Color="#73100A22" />
            <GradientStop Offset="0.72" Color="#00100A22" />
        </LinearGradientBrush.GradientStops>
