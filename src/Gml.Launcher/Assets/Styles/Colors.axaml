<!-- generated by tools/brand.py from branding/tokens.json and branding/site-derived.json, do not edit -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Stock GML keys, now on the site's palette -->
    <SolidColorBrush x:Key="PrimaryColor">#6A3FD1</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryColorHover">#9959F4</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryTransparentColor">#19102F</SolidColorBrush>
    <SolidColorBrush x:Key="AccentColor">#FF9D45</SolidColorBrush>

    <SolidColorBrush x:Key="HeadlineColor">#F4EFFB</SolidColorBrush>
    <SolidColorBrush x:Key="ContentColor">#C4B5DC</SolidColorBrush>

    <SolidColorBrush x:Key="BackgroundColor">#100A22</SolidColorBrush>

    <SolidColorBrush x:Key="FrameBackgroundColor">#21163C</SolidColorBrush>
    <SolidColorBrush x:Key="FrameBackgroundBorderColor">#5F4285</SolidColorBrush>

    <SolidColorBrush x:Key="SecondaryColor">#080511</SolidColorBrush>
    <SolidColorBrush x:Key="SecondaryColorHover">#19102F</SolidColorBrush>

    <SolidColorBrush x:Key="FormBackgroundColor">#19102F</SolidColorBrush>
    <SolidColorBrush x:Key="FormBackgroundHoverColor">#19102F</SolidColorBrush>
    <SolidColorBrush x:Key="FormBorderColor">#5F4285</SolidColorBrush>
    <SolidColorBrush x:Key="FormBorderHoverColor">#9959F4</SolidColorBrush>

    <SolidColorBrush x:Key="BadgeBorder">#20FFFFFF</SolidColorBrush>

    <LinearGradientBrush x:Key="ProfileLinearGradient" StartPoint="0%, 0%" EndPoint="0%, 100%" Opacity=".3">
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0" Color="Transparent" />
            <GradientStop Offset="1" Color="#6A3FD1" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ProfileImageLinearGradient" StartPoint="50%, -80%" EndPoint="50%, 100%" Opacity=".2">
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0" Color="#21163C" />
            <GradientStop Offset="1" Color="#21163C" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BackgroundOverlay" StartPoint="50%, -80%" EndPoint="50%, 100%" Opacity=".9">
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0" Color="Transparent" />
            <GradientStop Offset="0.3" Color="#100A22" />
            <GradientStop Offset="1" Color="#100A22" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

