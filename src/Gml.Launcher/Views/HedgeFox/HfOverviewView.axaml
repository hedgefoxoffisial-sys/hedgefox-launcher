<!-- «Играть»: the game menu's night with the title, under it the three latest posts (a click opens the post), and
     a bottom bar as in a game launcher: the version of the game on the left (picked for this PC, the list opens
     upwards), the wooden sign «ИГРАТЬ» in the middle on its tuft of fog («Сразу на сервер» under it: the game joins
     the server once it has loaded), the status on the right. While the game downloads the sign fills with light
     wood and shows the percent, the line under it what is left; the version cannot change.
     The stock OverviewPageViewModel runs the profiles, the download and the game; HfOverviewModel adds the rest. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hf="using:Gml.Launcher.Views.HedgeFox.Controls"
             xmlns:core="using:Gml.Launcher.Core.HedgeFox"
             xmlns:hfvm="using:Gml.Launcher.ViewModels.HedgeFox"
             x:Class="Gml.Launcher.Views.HedgeFox.HfOverviewView">
    <UserControl.Resources>
        <SolidColorBrush x:Key="HfBarBrush" Color="{DynamicResource HfVoidColor}" Opacity="0.94" />
        <SolidColorBrush x:Key="HfGlassBrush" Color="{DynamicResource HfVoidColor}" Opacity="0.72" />
        <SolidColorBrush x:Key="HfGlassHoverBrush" Color="{DynamicResource HfNightColor}" Opacity="0.86" />
    </UserControl.Resources>

    <!-- the news cards over the night: flat (no hard shadow, no purple top edge) and see-through, so the mountains
         behind them still read -->
    <UserControl.Styles>
        <Style Selector="hf|HfButton.card.glass">
            <Setter Property="Background" Value="{StaticResource HfGlassBrush}" />
        </Style>
        <Style Selector="hf|HfButton.card.glass:pointerover">
            <Setter Property="Background" Value="{StaticResource HfGlassHoverBrush}" />
        </Style>
        <Style Selector="hf|HfButton.card.glass /template/ hf|PixelBorder#PART_Frame">
            <Setter Property="ShadowOffset" Value="0" />
            <Setter Property="AccentTop" Value="0" />
        </Style>
    </UserControl.Styles>

    <Grid Name="Root" x:DataType="hfvm:HfOverviewModel" RowDefinitions="*,Auto,Auto">

        <!-- The title: the game's 288×54 at ×2, smaller when the window is narrow (moon and airship stay clear) -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="168,0,168,8">
            <Viewbox StretchDirection="DownOnly" MaxWidth="576">
                <Image Source="/Assets/HedgeFox/Images/Menu/title.png" Width="576" Height="108"
                       RenderOptions.BitmapInterpolationMode="HighQuality" />
            </Viewbox>
            <TextBlock Classes="hf-px24" Text="{x:Static core:HfStrings.TaglinePixel}"
                       Foreground="{DynamicResource HfTextBrush}" HorizontalAlignment="Center" Margin="0,-2,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect OffsetX="2" OffsetY="2" BlurRadius="0" Opacity="1" Color="#080511" />
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>

        <!-- The three latest posts; the feed's own words when there are none -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" MaxWidth="944" Margin="32,0,32,62">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <TextBlock Classes="hf-kicker" Text="{x:Static core:HfStrings.NewsCaps}" VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect OffsetX="2" OffsetY="2" BlurRadius="0" Opacity="1" Color="#080511" />
                    </TextBlock.Effect>
                </TextBlock>
                <hf:HfButton Grid.Column="1" Classes="text" FontSize="13" Margin="0,0,-6,0"
                             Command="{Binding GoNewsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="hf-status" Text="{x:Static core:HfStrings.AllNews}" VerticalAlignment="Center" />
                        <hf:PixelIcon Kind="arrow" VerticalAlignment="Center" />
                    </StackPanel>
                </hf:HfButton>
            </Grid>

            <!-- the row keeps its height while the feed loads: nothing jumps -->
            <Panel Grid.Row="1" Height="116">
                <ItemsControl Name="NewsRow" ItemsSource="{Binding Info.News}" IsVisible="{Binding Info.HasNews}"
                              Margin="-8,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:HfNewsCard">
                            <hf:HfButton Classes="card glass" Margin="8,0" Height="112" Padding="16,12,16,12"
                                         Command="{Binding $parent[ItemsControl].((hfvm:HfOverviewModel)DataContext).Info.OpenNewsCommand}"
                                         CommandParameter="{Binding}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="hf-px16" Text="{Binding Source}"
                                                   Foreground="{DynamicResource HfOrangeBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Date}" FontSize="12"
                                                   Foreground="{DynamicResource HfMutedBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource HfTextBrush}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Text}" FontSize="13" LineHeight="18"
                                               Foreground="{DynamicResource HfMutedBrush}"
                                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </hf:HfButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border IsVisible="{Binding Info.HasNewsMessage}" Height="112" VerticalAlignment="Top"
                        Background="{DynamicResource HfTicketBrush}" BorderBrush="{DynamicResource HfLineBrush}"
                        BorderThickness="2">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                        <TextBlock Classes="hf-small" Text="{Binding Info.NewsMessage}" HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                        <hf:HfButton Classes="text accent" FontSize="13" HorizontalAlignment="Center"
                                     Command="{Binding Page.OpenLinkCommand}"
                                     CommandParameter="{x:Static core:HfLinks.News}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Static core:HfStrings.NewsOnSite}" VerticalAlignment="Center" />
                                <hf:PixelIcon Kind="arrow" VerticalAlignment="Center" />
                            </StackPanel>
                        </hf:HfButton>
                    </StackPanel>
                </Border>
            </Panel>
        </Grid>

        <!-- The bottom bar -->
        <Panel Grid.Row="2" Height="80">
            <Border Background="{StaticResource HfBarBrush}" BorderBrush="{DynamicResource HfNightBrush}"
                    BorderThickness="0,2,0,0" />
            <!-- the fog tuft the sign stands on, as in the game's menu: it lies on the bar's edge, over it, and its
                 wisps hang down into the bar on both sides of the sign -->
            <hf:HfSprite Source="cloud.png" Frames="6" Scale="2" FrameMs="450" IsHitTestVisible="False"
                         HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-16,0,0" />

            <Grid ColumnDefinitions="*,Auto,*" Margin="24,0,24,0">
                <!-- the version of the game: «Подобрано для твоего ПК» over the advised one -->
                <hf:HfButton Name="VersionButton" Classes="picker" Classes.open="{Binding Picker.IsOpen}"
                             MinWidth="196" HorizontalAlignment="Left" VerticalAlignment="Center"
                             Command="{Binding Picker.ToggleCommand}"
                             IsVisible="{Binding Picker.HasCurrent}"
                             ToolTip.Tip="{Binding Picker.Hint}">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="1">
                            <TextBlock Text="{x:Static core:HfStrings.PickedForPc}" FontSize="11"
                                       Foreground="{DynamicResource HfBrassBrush}"
                                       IsVisible="{Binding Picker.CurrentIsAdvised}" />
                            <TextBlock Text="{x:Static core:HfStrings.GameVersion}" FontSize="11"
                                       Foreground="{DynamicResource HfMutedBrush}"
                                       IsVisible="{Binding !Picker.CurrentIsAdvised}" />
                            <TextBlock Text="{Binding Picker.CurrentTitle}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource HfTextBrush}" />
                        </StackPanel>
                        <hf:PixelIcon Grid.Column="1" Kind="less" Margin="14,0,0,0" VerticalAlignment="Center"
                                      IsVisible="{Binding !Picker.IsOpen}" />
                        <hf:PixelIcon Grid.Column="1" Kind="more" Margin="14,0,0,0" VerticalAlignment="Center"
                                      IsVisible="{Binding Picker.IsOpen}" />
                    </Grid>
                </hf:HfButton>

                <!-- «ИГРАТЬ», standing on the fog above the bar's edge; while downloading the sign is the meter -->
                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,-40,0,0" Spacing="10">
                    <Panel Width="320" Height="64">
                        <hf:HfButton Name="PlayButton" Classes="sign narrow"
                                     Command="{Binding Page.PlayCommand}"
                                     IsEnabled="{Binding CanPlay}"
                                     IsVisible="{Binding IsIdle}"
                                     Content="{x:Static core:HfStrings.PlayCaps}" />
                        <Panel IsVisible="{Binding IsBusy}">
                            <hf:HfSignMeter IsNarrow="True" Value="{Binding MeterValue}"
                                            IsIndeterminate="{Binding MeterIndeterminate}">
                                <hf:HfSignMeter.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Value" Duration="0:0:0.25" />
                                    </Transitions>
                                </hf:HfSignMeter.Transitions>
                            </hf:HfSignMeter>
                            <TextBlock Classes="hf-px32" Text="{Binding SignLabel}" Foreground="#FFE9A8"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4">
                                <TextBlock.Effect>
                                    <DropShadowEffect OffsetX="2" OffsetY="2" BlurRadius="0" Opacity="1" Color="#080511" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </Panel>
                    </Panel>
                    <Panel Height="18">
                        <TextBlock Text="{x:Static core:HfStrings.StraightToServer}" FontSize="12"
                                   Foreground="{DynamicResource HfMutedBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" IsVisible="{Binding IsIdle}" />
                        <TextBlock Classes="hf-status" Text="{Binding StepLine}" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap"
                                   IsVisible="{Binding IsBusy}" />
                    </Panel>
                </StackPanel>

                <!-- the status: «Онлайн 7 из 45» or «Сервер спит», the Pelena under it; nothing without data -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                                IsVisible="{Binding Info.HasOnlineLine}">
                        <hf:HfStatusDot State="{Binding Info.Dot}" VerticalAlignment="Center" />
                        <TextBlock Classes="hf-status" Text="{Binding Info.OnlineLine}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Info.PelenaShort}" FontSize="12" HorizontalAlignment="Right"
                               Foreground="{DynamicResource HfMutedBrush}" IsVisible="{Binding Info.HasPelena}" />
                </StackPanel>
            </Grid>
        </Panel>

        <!-- The list of versions, upwards from the picker; a click anywhere else closes it -->
        <Panel Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding Picker.IsOpen}">
            <Border Name="Dismiss" Background="Transparent" PointerPressed="OnDismiss" />
            <Panel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,70" Width="320">
                <!-- hard shadow -->
                <Border Background="{DynamicResource HfVoidBrush}" Margin="6,6,-6,-6" Opacity="0.7" />
                <Border Background="{DynamicResource HfNightBrush}" BorderBrush="{DynamicResource HfLineStrongBrush}"
                        BorderThickness="2" Padding="4">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="hf-kicker" FontSize="16" Text="{x:Static core:HfStrings.GameVersionCaps}"
                                   Margin="12,8,12,6" />
                        <ItemsControl ItemsSource="{Binding Picker.Versions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:HfProfileCard">
                                    <hf:HfButton Classes="option" Classes.selected="{Binding Selected}"
                                                 Command="{Binding $parent[ItemsControl].((hfvm:HfOverviewModel)DataContext).Picker.SelectCommand}"
                                                 CommandParameter="{Binding}">
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <hf:HfBadge FontSize="12" Padding="6,2,6,2" VerticalAlignment="Center"
                                                            IsVisible="{Binding Recommended}"
                                                            Content="{x:Static core:HfStrings.ForYourPcCaps}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Hint}" FontSize="12" LineHeight="16"
                                                       Foreground="{DynamicResource HfMutedBrush}" TextWrapping="Wrap"
                                                       IsVisible="{Binding HasHint}" />
                                        </StackPanel>
                                    </hf:HfButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Panel>
        </Panel>
    </Grid>
</UserControl>
