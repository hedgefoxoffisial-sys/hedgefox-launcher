<!-- «Вход»: one centred column over the game menu's night. The title and «Пираты над Пеленой», the nick and the
     password (solid fields as wide as the sign), the wooden sign «ВОЙТИ», «Регистрация» and «Забыл пароль?» under it;
     one tiny status line at the bottom.
     The stock LoginPageViewModel does the sign-in and the 2FA step; HfLoginModel adds the status line and the error. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hf="using:Gml.Launcher.Views.HedgeFox.Controls"
             xmlns:core="using:Gml.Launcher.Core.HedgeFox"
             xmlns:hfvm="using:Gml.Launcher.ViewModels.HedgeFox"
             x:Class="Gml.Launcher.Views.HedgeFox.HfLoginView">
    <Grid Name="Root" x:DataType="hfvm:HfLoginModel" RowDefinitions="*,Auto" Margin="16,0,16,16">

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,12">
            <Image Source="/Assets/HedgeFox/Images/Menu/title.png" Width="576" Height="108"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Classes="hf-px24" Text="{x:Static core:HfStrings.TaglinePixel}"
                       Foreground="{DynamicResource HfTextBrush}" HorizontalAlignment="Center" Margin="0,-1,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect OffsetX="2" OffsetY="2" BlurRadius="0" Opacity="1" Color="#080511" />
                </TextBlock.Effect>
            </TextBlock>

            <Panel Width="320" Margin="0,36,0,0">
                <!-- nick and password -->
                <StackPanel Spacing="12" IsVisible="{Binding !Page.Is2FaVisible}">
                    <TextBox Name="LoginBox" Text="{Binding Page.Login}" Watermark="{x:Static core:HfStrings.LoginField}" />
                    <TextBox PasswordChar="•" Text="{Binding Page.Password}" Watermark="{x:Static core:HfStrings.PasswordField}" />
                    <TextBlock Classes="hf-small hf-error" Text="{Binding Error}" IsVisible="{Binding HasError}"
                               TextAlignment="Center" />
                    <hf:HfButton Classes="sign narrow"
                                 Margin="0,8,0,0"
                                 Command="{Binding Page.LoginCommand}"
                                 IsDefault="{Binding !Page.Is2FaVisible}"
                                 IsEnabled="{Binding Page.BackendIsActive}"
                                 Content="{x:Static core:HfStrings.SignInCaps}" />
                    <hf:HfMeter IsIndeterminate="True" Height="10" IsVisible="{Binding Page.IsProcessing}" />
                    <!-- the GML sign-in server did not answer at start: offline mode, «Войти» is off -->
                    <TextBlock Classes="hf-small" Foreground="{DynamicResource HfTextBrush}" TextAlignment="Center"
                               Text="{x:Static core:HfStrings.LoginOffline}" IsVisible="{Binding !Page.BackendIsActive}" />
                    <!-- «Регистрация» is the second action; the links stand 24 px apart -->
                    <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <hf:HfButton Classes="text accent"
                                     Command="{Binding Page.OpenLinkCommand}"
                                     CommandParameter="{x:Static core:HfLinks.Register}"
                                     Content="{x:Static core:HfStrings.Register}" />
                        <hf:HfButton Classes="text quiet"
                                     Command="{Binding Page.OpenLinkCommand}"
                                     CommandParameter="{x:Static core:HfLinks.Forgot}"
                                     Content="{x:Static core:HfStrings.Forgot}" />
                    </StackPanel>
                </StackPanel>

                <!-- the second step for accounts with 2FA -->
                <StackPanel Spacing="12" IsVisible="{Binding Page.Is2FaVisible}">
                    <TextBox Name="CodeBox"
                             Text="{Binding Page.TwoFactorCode}"
                             Watermark="{x:Static core:HfStrings.TwoFactorField}"
                             MaxLength="6"
                             FontSize="22"
                             FontWeight="SemiBold"
                             HorizontalContentAlignment="Center" />
                    <TextBlock Classes="hf-small hf-error" Text="{Binding Error}" IsVisible="{Binding HasError}"
                               TextAlignment="Center" />
                    <hf:HfButton Classes="sign narrow"
                                 Margin="0,8,0,0"
                                 Command="{Binding Page.Verify2FaCommand}"
                                 IsDefault="{Binding Page.Is2FaVisible}"
                                 Content="{x:Static core:HfStrings.TwoFactorConfirmCaps}" />
                    <hf:HfMeter IsIndeterminate="True" Height="10" IsVisible="{Binding Page.IsProcessing}" />
                    <hf:HfButton Classes="text" HorizontalAlignment="Center"
                                 Command="{Binding CancelTwoFactorCommand}"
                                 Content="{x:Static core:HfStrings.Back}" />
                </StackPanel>
            </Panel>
        </StackPanel>

        <!-- one tiny status line: «Онлайн 7 из 45» or «Сервер спит»; nothing without data -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                    IsVisible="{Binding Info.HasOnlineLine}">
            <hf:HfStatusDot State="{Binding Info.Dot}" VerticalAlignment="Center" />
            <TextBlock Classes="hf-status" Text="{Binding Info.OnlineLine}" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
