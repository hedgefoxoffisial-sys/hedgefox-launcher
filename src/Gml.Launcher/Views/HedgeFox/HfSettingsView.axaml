<!-- Настройки: one quiet night plate in the middle. Memory with the «советуем» mark, the game window and the game
     folder side by side; under them «Игра»: the mods of the chosen profile and «Переустановить» (asks first).
     The stock SettingsPageViewModel loads and saves (it saves 0.4 s after a change); HfSettingsModel adds the
     gigabytes, the mark and the main screen's mods and reinstall. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hf="using:Gml.Launcher.Views.HedgeFox.Controls"
             xmlns:core="using:Gml.Launcher.Core.HedgeFox"
             xmlns:hfvm="using:Gml.Launcher.ViewModels.HedgeFox"
             x:Class="Gml.Launcher.Views.HedgeFox.HfSettingsView">
    <Grid Name="Root" x:DataType="hfvm:HfSettingsModel" RowDefinitions="Auto,*" Margin="16,4,16,16">
        <hf:HfButton Classes="text" HorizontalAlignment="Left" Command="{Binding Page.GoBackCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <hf:PixelIcon Kind="back" />
                <TextBlock Text="{x:Static core:HfStrings.Back}" VerticalAlignment="Center" />
            </StackPanel>
        </hf:HfButton>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0" Margin="0,4,0,0">
            <StackPanel Width="760" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <TextBlock Classes="hf-px32" Text="{x:Static core:HfStrings.SettingsCaps}" HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect OffsetX="3" OffsetY="3" BlurRadius="0" Opacity="1" Color="#080511" />
                    </TextBlock.Effect>
                </TextBlock>

                <Border Background="{DynamicResource HfTicketBrush}" BorderBrush="{DynamicResource HfLineBrush}"
                        BorderThickness="1" Padding="28,24,28,24">
                    <StackPanel Spacing="22">
                        <Grid ColumnDefinitions="*,40,*">
                            <!-- Memory -->
                            <StackPanel Spacing="12">
                                <TextBlock Classes="hf-label" Text="{x:Static core:HfStrings.MemorySetting}" />
                                <CheckBox Content="{x:Static core:HfStrings.MemoryAuto}" IsChecked="{Binding Page.DynamicRamValue}" />
                                <StackPanel Spacing="2" IsEnabled="{Binding IsManualRam}" Margin="0,4,0,0">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="hf-small" Text="{x:Static core:HfStrings.MemoryForGame}" VerticalAlignment="Bottom" />
                                        <TextBlock Grid.Column="1" Classes="hf-px24" Foreground="{DynamicResource HfOrangeBrush}"
                                                   Text="{Binding RamText}" />
                                    </Grid>
                                    <hf:HfMarkPanel Fraction="{Binding MarkFraction}" Inset="9" IsVisible="{Binding HasMark}" Margin="0,6,0,0">
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="hf-small" Foreground="{DynamicResource HfBrassBrush}" Text="{Binding MarkText}"
                                                       HorizontalAlignment="Center" />
                                            <Border Width="2" Height="8" Background="{DynamicResource HfBrassBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </hf:HfMarkPanel>
                                    <Slider Minimum="{Binding Page.MinRamValue}"
                                            Maximum="{Binding Page.MaxRamValue}"
                                            Value="{Binding Page.RamValue}"
                                            TickFrequency="{Binding Page.RamTickValue}"
                                            IsSnapToTickEnabled="True" />
                                    <Grid ColumnDefinitions="*,*">
                                        <TextBlock Classes="hf-small" Text="{Binding MinText}" />
                                        <TextBlock Grid.Column="1" Classes="hf-small" Text="{Binding MaxText}" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="22">
                                <!-- Game window -->
                                <StackPanel Spacing="12">
                                    <TextBlock Classes="hf-label" Text="{x:Static core:HfStrings.WindowSetting}" />
                                    <CheckBox Content="{x:Static core:HfStrings.FullScreen}" IsChecked="{Binding Page.FullScreen}" />
                                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10" IsVisible="{Binding IsWindowed}">
                                        <TextBox Text="{Binding Page.WindowWidth}" Watermark="{x:Static core:HfStrings.WindowWidth}"
                                                 ToolTip.Tip="{x:Static core:HfStrings.WindowWidth}" />
                                        <TextBlock Grid.Column="1" Classes="hf-body hf-muted" Text="×" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="2" Text="{Binding Page.WindowHeight}" Watermark="{x:Static core:HfStrings.WindowHeight}"
                                                 ToolTip.Tip="{x:Static core:HfStrings.WindowHeight}" />
                                    </Grid>
                                </StackPanel>

                                <!-- Game folder -->
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="hf-label" Text="{x:Static core:HfStrings.GameFolder}" />
                                    <TextBlock Classes="hf-small" Foreground="{DynamicResource HfTextBrush}"
                                               Text="{Binding Page.InstallationFolder}"
                                               TextWrapping="NoWrap" TextTrimming="PathSegmentEllipsis"
                                               ToolTip.Tip="{Binding Page.InstallationFolder}" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="-6,0,0,0">
                                        <hf:HfButton Classes="text" Click="OnPickFolder" Content="{x:Static core:HfStrings.ChangeFolder}" />
                                        <TextBlock Classes="hf-small" Text="·" VerticalAlignment="Center" />
                                        <hf:HfButton Classes="text" Click="OnOpenFolder" Content="{x:Static core:HfStrings.OpenFolder}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- The game: the chosen profile's mods, and the reinstall that asks first -->
                        <StackPanel Spacing="10" IsVisible="{Binding HasGame}">
                            <Border Height="1" Background="{DynamicResource HfLineBrush}" Margin="0,0,0,10" />
                            <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding !Reinstall.IsAsking}">
                                <TextBlock Classes="hf-label" Text="{x:Static core:HfStrings.GameSetting}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                                    <hf:HfButton Classes="ghost sm"
                                                 Command="{Binding ModsCommand}"
                                                 IsVisible="{Binding HasMods}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <hf:PixelIcon Kind="folder" />
                                            <TextBlock Text="{x:Static core:HfStrings.Mods}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </hf:HfButton>
                                    <hf:HfButton Classes="ghost sm"
                                                 Command="{Binding Reinstall.AskCommand}"
                                                 ToolTip.Tip="{x:Static core:HfStrings.ReinstallHint}"
                                                 ToolTip.ShowOnDisabled="True"
                                                 Content="{x:Static core:HfStrings.Reinstall}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Classes="hf-small" Text="{x:Static core:HfStrings.ReinstallHint}"
                                       IsVisible="{Binding !Reinstall.IsAsking}" />

                            <!-- the question in place of the row -->
                            <StackPanel Spacing="12" IsVisible="{Binding Reinstall.IsAsking}">
                                <TextBlock Classes="hf-label" Text="{x:Static core:HfStrings.ReinstallAskTitle}" />
                                <TextBlock Classes="hf-small" Foreground="{DynamicResource HfTextBrush}"
                                           Text="{x:Static core:HfStrings.ReinstallAsk}" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <hf:HfButton Classes="secondary sm"
                                                 Command="{Binding Reinstall.ConfirmCommand}"
                                                 Content="{x:Static core:HfStrings.ReinstallYes}" />
                                    <hf:HfButton Classes="ghost sm"
                                                 Command="{Binding Reinstall.CancelCommand}"
                                                 Content="{x:Static core:HfStrings.Cancel}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
