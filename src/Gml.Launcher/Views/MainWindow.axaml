<!-- HedgeFox shell (fork-owned): opaque night window; once signed in, the sidebar (HfSidebar) down the left edge
     and the game menu's night scene to the right of it, behind the routed pages (on the sign-in page the scene fills
     the window); our own 32 px title bar over all (HfWindowChrome sets the frame per OS) and the notifications. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Gml.Launcher.ViewModels"
        xmlns:rxui="clr-namespace:Avalonia.ReactiveUI;assembly=Avalonia.ReactiveUI"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:Gml.Launcher.Core.Helpers"
        xmlns:hf="using:Gml.Launcher.Views.HedgeFox.Controls"
        xmlns:hfv="using:Gml.Launcher.Views.HedgeFox"
        xmlns:controls="clr-namespace:GamerVII.Notification.Avalonia.Controls;assembly=GamerVII.Notification.Avalonia"
        mc:Ignorable="d"
        d:DesignWidth="1180"
        d:DesignHeight="720"
        Width="1180"
        Height="720"
        MinWidth="1000"
        MinHeight="620"
        CanResize="True"
        Closed="WindowClosed"
        x:Class="Gml.Launcher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Background="{DynamicResource HfBgBrush}"
        TransparencyLevelHint="None"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/Images/logo.ico"
        Title="HedgeFox">

    <!-- a maximised window on Windows has its frame off-screen (OffScreenMargin): everything steps in by it -->
    <Grid Margin="{Binding $parent[Window].OffScreenMargin}">
        <Grid ColumnDefinitions="Auto,*">
            <!-- «Играть», «Новости», «Настройки» and the player; DataContext: HfShellModel (MainWindow.axaml.cs) -->
            <hfv:HfSidebar Name="Sidebar" />

            <!-- The night of the game's main menu: sky, stars, moon, peaks, fog and the airship (HfMenuScene) -->
            <hf:HfMenuScene Name="Scene" Grid.Column="1" ClipToBounds="True" />

            <rxui:RoutedViewHost Grid.Column="1" Margin="0,32,0,0" Router="{Binding Router}">
                <rxui:RoutedViewHost.DefaultContent>
                    <Panel />
                </rxui:RoutedViewHost.DefaultContent>
                <rxui:RoutedViewHost.ViewLocator>
                    <helpers:AppViewLocator />
                </rxui:RoutedViewHost.ViewLocator>
            </rxui:RoutedViewHost>
        </Grid>

        <hfv:HfTitleBar Name="TitleBar" VerticalAlignment="Top" />

        <!-- MessageBar: under the title bar -->
        <controls:NotificationMessageContainer Name="Toasts" Margin="0,32,0,0" Manager="{Binding Manager}" />
    </Grid>

</Window>
