<!-- HedgeFox shell (fork-owned): opaque night window, the Pelena scene with a veil and one slow fog strip, our own
     32 px title bar (HfWindowChrome sets the frame per OS), the routed pages and the notifications. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Gml.Launcher.ViewModels"
        xmlns:rxui="clr-namespace:Avalonia.ReactiveUI;assembly=Avalonia.ReactiveUI"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:Gml.Launcher.Core.Helpers"
        xmlns:hf="using:Gml.Launcher.Views.HedgeFox.Controls"
        xmlns:hfv="using:Gml.Launcher.Views.HedgeFox"
        xmlns:controls="clr-namespace:GamerVII.Notification.Avalonia.Controls;assembly=GamerVII.Notification.Avalonia"
        mc:Ignorable="d"
        d:DesignWidth="1180"
        d:DesignHeight="720"
        Width="1180"
        Height="720"
        MinWidth="1000"
        MinHeight="620"
        CanResize="True"
        Closed="WindowClosed"
        x:Class="Gml.Launcher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Background="{DynamicResource HfBgBrush}"
        TransparencyLevelHint="None"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/Images/logo.ico"
        Title="HedgeFox">

    <!-- a maximised window on Windows has its frame off-screen (OffScreenMargin): everything steps in by it -->
    <Grid Margin="{Binding $parent[Window].OffScreenMargin}">
        <!-- The night scene: the site's Pelena composite (branding/background.jpg), scaled down smoothly -->
        <Image Name="Scene"
               Source="/Assets/Images/background.jpg"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />
        <hf:HfFogLayer Name="Fog" VerticalAlignment="Bottom" Height="192" Opacity="0.2" />
        <Rectangle Name="Veil" Fill="{DynamicResource HfVeilBrush}" />
        <Rectangle Name="ScrimBottom" Fill="{DynamicResource HfScrimBottomBrush}" />

        <Grid RowDefinitions="32,*">
            <hfv:HfTitleBar Name="TitleBar" />
            <rxui:RoutedViewHost Grid.Row="1" Router="{Binding Router}">
                <rxui:RoutedViewHost.DefaultContent>
                    <Panel />
                </rxui:RoutedViewHost.DefaultContent>
                <rxui:RoutedViewHost.ViewLocator>
                    <helpers:AppViewLocator />
                </rxui:RoutedViewHost.ViewLocator>
            </rxui:RoutedViewHost>
        </Grid>

        <!-- MessageBar -->
        <controls:NotificationMessageContainer Margin="0,32,0,0" Manager="{Binding Manager}" />
    </Grid>

</Window>
