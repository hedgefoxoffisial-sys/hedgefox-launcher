<!-- Splash (fork-owned): the stock checks run in SplashScreenViewModel; the look is the site's loader
     (Views/HedgeFox/HfSplashView: orange title, pixel cogs, striped meter, Tiny5 hints). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Gml.Launcher.ViewModels"
        xmlns:hfv="using:Gml.Launcher.Views.HedgeFox"
        mc:Ignorable="d"
        d:DesignWidth="640"
        d:DesignHeight="440"
        Width="640"
        Height="440"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="{DynamicResource HfBgBrush}"
        TransparencyLevelHint="None"
        Icon="/Assets/Images/logo.ico"
        x:Class="Gml.Launcher.Views.SplashScreen.SplashScreen"
        x:DataType="viewModels:SplashScreenViewModel"
        Title="HedgeFox">

    <hfv:HfSplashView />

</Window>
