<Project Sdk="Microsoft.NET.Sdk">
  <!-- Screenshot harness: renders the launcher's windows and pages offscreen (Avalonia.Headless + Skia) with fake
       services and fixed data. Not part of Gml.Launcher.sln and never shipped. See HEDGEFOX.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HedgeFox.Shots</AssemblyName>
    <RootNamespace>HedgeFox.Shots</RootNamespace>
    <NoWarn>$(NoWarn);NU1701;NETSDK1206</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Gml.Launcher/Gml.Launcher.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
